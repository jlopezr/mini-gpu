# Estilo común del repo (referencia: 39.mini-gl/src/processing.c). La extensión
# C/C++ de VS Code lo usa al guardar, solo en las líneas modificadas: el código
# antiguo se va adaptando a medida que se toca. Funciones siempre desplegadas y
# separadas por una línea en blanco; límite de 100 columnas.
# Excepciones: los submódulos de .clang-format-ignore y v.tui (tiene el suyo).
BasedOnStyle: LLVM
IndentWidth: 4
ContinuationIndentWidth: 4
BreakBeforeBraces: Attach
ColumnLimit: 100
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortBlocksOnASingleLine: Always
AllowShortFunctionsOnASingleLine: None
AllowShortCaseLabelsOnASingleLine: true
AlignAfterOpenBracket: DontAlign
AlignOperands: DontAlign
AlignTrailingComments: false
AlignConsecutiveAssignments: None
AlignConsecutiveDeclarations: None
SortIncludes: Never
IndentCaseLabels: true
SpaceBeforeParens: ControlStatements
PointerAlignment: Right
ReflowComments: false
MaxEmptyLinesToKeep: 1
AllowShortRecordOnASingleLine: Always
SeparateDefinitionBlocks: Always
BreakBeforeTernaryOperators: false
