#!/usr/bin/env bash
# Lanzador global de run_board.py; prefiere el python de .venv porque necesita
# pyserial, igual que x.tests/test.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_PY="$ROOT/.venv/bin/python3"

if [[ -n "${PYTHON:-}" ]]; then
  PY="$PYTHON"
elif [[ -x "$VENV_PY" ]]; then
  PY="$VENV_PY"
else
  PY="python3"
fi

exec "$PY" "$ROOT/tools/run_board.py" "$@"
