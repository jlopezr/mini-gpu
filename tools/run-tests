#!/usr/bin/env python3
"""Lanzador global de la suite de t.tests (funciona desde cualquier directorio).

Antes esto llamaba a `t.tests/test`, que es un script de bash, y en Windows
fallaba con un CreateProcess: `tools/run-tests.ps1` existia pero no podia
funcionar. La logica vive ahora AQUI, en Python, que es lo unico que las tres
plataformas ejecutan igual, y `t.tests/test` pasa a ser un envoltorio de dos
lineas. Una sola implementacion y dos puertas de entrada, en vez de dos
implementaciones que se separan en cuanto alguien toca una.
"""
import argparse
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
TESTS = ROOT / "t.tests"

def interprete() -> str:
    """El python del entorno del repo si lo hay, y si no el que nos ejecuta.

    `Scripts` es la ruta de Windows y `bin` la de POSIX; se prueban las dos en
    vez de mirar `sys.platform` porque un .venv copiado entre maquinas puede
    tener cualquiera de las dos y el coste de mirar es un `exists()`.
    """
    for relativa in ("Scripts/python.exe", "bin/python3", "bin/python"):
        candidato = ROOT / ".venv" / relativa
        if candidato.exists():
            return str(candidato)
    return sys.executable


def entorno() -> dict:
    """La raiz del repo en PYTHONPATH: los tests importan `tools`."""
    variables = dict(os.environ)
    previo = variables.get("PYTHONPATH")
    variables["PYTHONPATH"] = (f"{ROOT}{os.pathsep}{previo}" if previo
                               else str(ROOT))
    return variables


def parsear(argv: list[str]) -> tuple[argparse.Namespace, list[str]]:
    """Las opciones propias y lo que se reenvía a `run_tests.py`.

    Reenvía, por este orden, lo que `argparse` no reconoce y todo lo que sigue a un `--`
    (que no se interpreta: es la forma de pasar algo que se llame igual que una opción
    propia). `allow_abbrev=False` para que `--ver` no se coma una opción de `run_tests.py`.
    """
    propios, separador, despues = [], False, []
    for argumento in argv:
        if separador:
            despues.append(argumento)
        elif argumento == "--":
            separador = True
        else:
            propios.append(argumento)
    parser = argparse.ArgumentParser(
        prog="run-tests", allow_abbrev=False, formatter_class=argparse.RawDescriptionHelpFormatter,
        usage="run-tests [--quick] [--verbose] [--hardware] [-- <args para run_tests.py>]",
        description=__doc__.splitlines()[0],
        epilog="Lo que no reconoce (casos, --backend, -p, --trace...) se reenvía a run_tests.py, "
               "igual que todo lo que siga a `--`.")
    parser.add_argument("--quick", action="store_true",
                        help="solo los tests unitarios de la infraestructura (sin simular casos)")
    parser.add_argument("--verbose", action="store_true", help="salida detallada")
    parser.add_argument("--hardware", action="store_true",
                        help="la suite de casos contra placa real (backend fpga-gpu por defecto)")
    args, desconocidos = parser.parse_known_args(propios)
    return args, [*desconocidos, *despues]


def main(argv: list[str]) -> int:
    args, extra = parsear(argv)
    rapido, detallado, hardware = args.quick, args.verbose, args.hardware

    if not TESTS.is_dir():
        print(f"error: no existe {TESTS}", file=sys.stderr)
        return 2

    python = interprete()
    variables = entorno()

    print("== Tests unitarios de infraestructura ==")
    # Los tests viven en t.tests/unit/<tema>/ (paquetes): `-t .` pone t.tests en el path, de donde salen
    # `run_tests` y `backends`.
    orden = [python, "-m", "unittest", "discover", "-s", "unit", "-t", ".", "-p", "test_*.py"]
    if detallado:
        orden.append("-v")
    codigo = subprocess.call(orden, cwd=str(TESTS), env=variables)
    if codigo or rapido:
        return codigo

    # Sin argumentos, --hardware elige el backend de placa; con ellos manda lo
    # que haya pedido quien llama.
    if hardware and not extra:
        extra = ["--backend", "fpga-gpu"]

    print("== Suite de casos (run_tests.py) ==")
    return subprocess.call([python, str(TESTS / "run_tests.py"), *extra],
                           cwd=str(TESTS), env=variables)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
