#!/usr/bin/env bash
# Lanzador global de `tools/build_compare.py` (compara el ultimo build de apio y el de Diamond;
# lee reports/*/summary.json de los dos flujos). Funciona con
# cualquier prototipo con informes, sin copiar nada a su carpeta.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV_PY="$ROOT/.venv/bin/python3"

if [[ -n "${PYTHON:-}" ]]; then
  PY="$PYTHON"
elif [[ -x "$VENV_PY" ]]; then
  PY="$VENV_PY"
else
  PY="python3"
fi

export PYTHONPATH="${ROOT}${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m tools.build_compare "$@"
