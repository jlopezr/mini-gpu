#!/usr/bin/env python3
"""Captura N frames consecutivos de la placa, de forma determinista.

Común a los prototipos con video + HDMI que comparten la ventana de
registros de burst (16, 18, 19, 21): resuelve el prototipo, ensambla el
programa, lo carga y lo deja correr hasta un intercambio CONCRETO usando el
registro HALT_AT. Entonces la CPU está parada, el frame acaba de completarse
y está entero en el buffer frontal: se lee y se guarda.

Por qué se para en el intercambio y no tras N frames de vídeo
---------------------------------------------------------------

Parar cuando el contador de frames llega a N para la CPU en un punto
cualquiera de su dibujo. El buffer trasero queda a medias, y lo que se
capture depende de la velocidad relativa entre la CPU y el barrido — que es
justo lo que hace que tear_demo_fast tenga una costura viajando cada 63 ms.
La captura saldría distinta cada vez y el test sería intermitente.

Parando en el N-ésimo intercambio COMPLETADO, el frame está entero por
construcción. Determinista y repetible.

Cada frame necesita una ejecución desde el principio, porque la única forma
de leer memoria es con la CPU parada. Son ~1,5 s de lectura por frame a
1 Mbaud, pero los programas son deterministas desde el reset, así que el
frame N sale igual siempre.

Los ficheros salen como <prefijo>_NNN.bin, en RGB565 crudo de 320x240, en el
directorio actual: es lo que comen make-framebuffer y compare-frames.py.

Habla MMIO v2 y por palabras enteras
------------------------------------

Las direcciones se importan de `tools/mmio_map.py`, no se cablean, y los
registros se escriben con `write-word`. Las dos cosas estuvieron mal a la vez:
esto se quedó en el mapa v1 --video en 0x80000000, que en v2 es SYSTEM-- y
escribía cada palabra en cuatro `write-byte`, lo que rearma `HALT_AT` cuatro
veces con valores intermedios y dispara la captura donde no toca. Lo segundo
está descrito en `mmio_decoder.v`, que nombra a esta herramienta.

Los tests de `x.tests/test_video_tools.py` no lo cogieron porque prueban el
parseo de las respuestas con el monitor simulado, y ahí una dirección
equivocada da una respuesta igual de válida.
"""
from __future__ import annotations

import argparse
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from tools.mmio_map import (
    MMIO_VIDEO_BASE, MMIO_VIDEO_FB_FRONT_OFF, MMIO_VIDEO_HALT_AT_OFF,
    MMIO_VIDEO_HALT_TARGET_OFF, MMIO_VIDEO_STATUS_OFF,
    MMIO_VIDEO_SWAP_COUNT_OFF,
)
from tools.run_board import assemble, detect_port, resolve_program, resolve_target, run_monitor_cli

# Las direcciones salen de `tools/mmio_map.py`, que es el mapa generado, y no
# van cableadas: estuvieron cableadas al mapa v1 (vídeo en 0x80000000) y se
# quedaron ahí cuando la migración a v2 movió la ventana a 0x80200000 y corrió
# los registros. En v2 0x80000000 es SYSTEM, así que esto leía el magic de
# SYS_ID creyendo que era un FB_FRONT.
FB_FRONT = MMIO_VIDEO_BASE + MMIO_VIDEO_FB_FRONT_OFF
STATUS = MMIO_VIDEO_BASE + MMIO_VIDEO_STATUS_OFF
SWAP_COUNT = MMIO_VIDEO_BASE + MMIO_VIDEO_SWAP_COUNT_OFF
HALT_AT = MMIO_VIDEO_BASE + MMIO_VIDEO_HALT_AT_OFF
HALT_TARGET = MMIO_VIDEO_BASE + MMIO_VIDEO_HALT_TARGET_OFF
HALT_TARGET_CPU = 1 << 0


def write_reg(prototype_dir: Path, port: str, address: int, value: int) -> None:
    """Una palabra, en UN comando.

    Antes eran cuatro `write-byte`, y con `HALT_AT` eso no es una ineficiencia
    sino un fallo: escribirlo rearma la alarma y reinicia el contador de frames
    CADA VEZ, así que en cuatro trozos se rearmaba cuatro veces con valores
    intermedios (0x000000NN, 0x0000NNNN...) y la captura se disparaba donde no
    tocaba. Está descrito en `mmio_decoder.v` --que nombra a esta herramienta--
    y es el ejemplo de §16.2 del mapa.
    """
    run_monitor_cli(prototype_dir, port, "write-word", f"0x{address:08x}", str(value))


def read_reg(prototype_dir: Path, port: str, address: int) -> int:
    # `read-word` imprime «Address 0x80200004: 0x01000000», no el número suelto.
    text = run_monitor_cli(prototype_dir, port, "read-word", f"0x{address:08x}")
    line = text.strip().splitlines()[-1]
    if ":" not in line:
        raise SystemExit(f"error: respuesta inesperada de read-word: '{line}'")
    return int(line.rsplit(":", 1)[1].strip(), 16)


def arm_halt(prototype_dir: Path, port: str, swap: int) -> None:
    """Arma la alarma para que la CPU pare en el intercambio `swap`.

    El orden no es indiferente: `HALT_TARGET` va PRIMERO. Es nuevo en MMIO v2
    (§9.6) --la alarma dice A QUIEN para-- y arranca a cero, así que sin
    escribirlo `HALT_AT` se arma y no para a nadie: la captura agotaría su
    espera en todos los programas, hicieran swaps o no.

    Vive en su propia función para que el orden se pueda probar sin placa.
    """
    write_reg(prototype_dir, port, HALT_TARGET, HALT_TARGET_CPU)
    write_reg(prototype_dir, port, HALT_AT, swap)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("-p", "--prototype", required=True)
    parser.add_argument("program")
    parser.add_argument("--frames", type=int, default=3, help="Cuántos frames consecutivos capturar")
    parser.add_argument("--desde", type=int, default=3,
                        help="Número del primer intercambio a capturar (los primeros frames de las "
                             "demos son de arranque, a veces interesa empezar más tarde)")
    parser.add_argument("--prefijo", default="capture")
    parser.add_argument("--port", default=None, help="por defecto, detecta el primer adaptador FTDI conectado")
    args = parser.parse_args(argv)
    port = args.port if args.port is not None else detect_port()

    target = resolve_target(args.prototype)
    source = resolve_program(target.prototype_dir, args.program, target.root)
    binary = assemble(target.root, source, verbose=False) if source.suffix == ".asm" else source

    print(f"Capturando {args.frames} frames de {args.program}, desde el intercambio {args.desde}")

    for n in range(args.frames):
        swap = args.desde + n

        # El orden importa: resetear ANTES de escribir, porque el monitor
        # rechaza cualquier acceso a memoria mientras la CPU corre.
        run_monitor_cli(target.prototype_dir, port, "reset")
        run_monitor_cli(target.prototype_dir, port, "write-block", "0x00000000", str(binary))

        # Borrar el underflow de la pasada anterior. Sin esto, el primer
        # frame que lo provoque contamina todos los demás.
        write_reg(target.prototype_dir, port, STATUS, 1)
        arm_halt(target.prototype_dir, port, swap)

        run_monitor_cli(target.prototype_dir, port, "run")

        # Esperar a que HALT_AT pare la CPU.
        deadline = time.monotonic() + 20.0
        halted = False
        while time.monotonic() < deadline:
            time.sleep(0.1)
            status_text = run_monitor_cli(target.prototype_dir, port, "status")
            if "halted=True" in status_text:
                halted = True
                break
        if not halted:
            raise SystemExit(f"error: la CPU no paró en el intercambio {swap}; ¿el programa hace swaps?")

        front = read_reg(target.prototype_dir, port, FB_FRONT)
        status = read_reg(target.prototype_dir, port, STATUS)
        swaps = read_reg(target.prototype_dir, port, SWAP_COUNT)

        fichero = f"{args.prefijo}_{swap:03d}.bin"
        # Ruta absoluta: run_monitor_cli ejecuta monitor.py con cwd en la
        # carpeta del prototipo, y el fichero debe salir en el directorio
        # actual del usuario, no ahí.
        fichero_path = Path.cwd() / fichero
        run_monitor_cli(target.prototype_dir, port, "read-block", f"0x{front:08x}", "153600", str(fichero_path))

        under = "SI" if status & 1 else "no"
        print(f"  intercambio {swap:3d}: front=0x{front:08x}  swaps={swaps}  underflow={under}  -> {fichero}")

        if status & 1:
            print(f"!! underflow en el frame {swap}: la imagen capturada puede estar rota", file=sys.stderr)

    print()
    print("Comparar dos capturas:")
    print(f"  python3 tools/compare-frames.py --rgb565 320x240 \\")
    print(f"      {args.prefijo}_{args.desde:03d}.bin {args.prefijo}_{args.desde + 1:03d}.bin")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
