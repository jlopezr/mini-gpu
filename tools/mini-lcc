#!/usr/bin/env python3
"""Compila C a ensamblador MiniISA usando el submodulo u.lcc."""
from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from msvc_env import ensure_msvc_environment  # noqa: E402

ROOT =Path(__file__).resolve().parents[1]
MINI_LCC = ROOT / "u.lcc"
WINDOWS = sys.platform == "win32"
RCC = MINI_LCC / "build" / ("rcc.exe" if WINDOWS else "rcc")
INCLUDE = MINI_LCC / "include" / "mini" / "none"
# El preprocesador es el del host (cc o cl), no el de lcc: sin sus macros (-undef, /u), que harian creer al
# codigo que se compila para el host (__GNUC__, __APPLE__, __SIZEOF_LONG__ == 8...), y con las de la maquina.
# __LCC__ es la que pone el driver original de lcc; __MINIGPU__, que el destino es MiniGPU.
PREDEFINED = ("__LCC__", "__MINIGPU__")


def run(command: list[str], cwd: Path = MINI_LCC) -> int:
    return subprocess.call(command, cwd=str(cwd))


def ensure_rcc() -> int:
    if RCC.exists():
        return 0
    (MINI_LCC / "build").mkdir(exist_ok=True)
    if WINDOWS:
        return run([
            "powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
            "-File", str(MINI_LCC / "build-mini.ps1"),
        ])
    return run([
        "make",
        f"BUILDDIR={MINI_LCC / 'build'}",
        "HOSTFILE=etc/linux.c",
        "CFLAGS=-g -std=gnu89 -Wno-implicit-function-declaration",
        "rcc",
    ])


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path, help="fuente .c o .i")
    parser.add_argument("-o", "--output", type=Path, help="ensamblador de salida")
    parser.add_argument("--keep-i", type=Path, metavar="PATH",
                        help="guarda tambien el C preprocesado")
    parser.add_argument("-I", dest="includes", action="append", type=Path, default=[], metavar="DIR",
                        help="carpeta extra para #include (repetible)")
    parser.add_argument("-D", dest="defines", action="append", default=[], metavar="NOMBRE[=VALOR]",
                        help="define una macro al preprocesar (repetible)")
    parser.add_argument("--no-crt", action="store_true",
                        help="no emite `_start` ni `.comm __stack`: el arranque lo pone un crt0 "
                             "(runtime/src/crt0.s) o, en una unidad sin `main`, nadie")
    parser.add_argument("--fp32", action="store_true",
                        help="+ - * / de float con FADD/FSUB/FMUL/FDIV (capability fp32, solo la 38) en vez de "
                             "softfloat; define __MINI_FP32__. FP32 es DAZ/FTZ: con subnormales puede no dar "
                             "los mismos bits que softfloat")
    args = parser.parse_args(argv)
    rcc_flags = ["-crt=none"] if args.no_crt else []
    if args.fp32:
        rcc_flags.append("-fp32")
        args.defines.append("__MINI_FP32__")

    script = MINI_LCC / "run-mini-tst.py"
    if not script.exists():
        print("error: falta el submodulo u.lcc", file=sys.stderr)
        print("Inicializalo con: git submodule update --init --recursive u.lcc", file=sys.stderr)
        return 2
    if not args.source.exists():
        print(f"error: no existe {args.source}", file=sys.stderr)
        return 2
    source = args.source.resolve()
    if ensure_rcc() != 0:
        return 1

    output = (args.output or args.source.with_suffix(".s")).resolve()
    output.parent.mkdir(parents=True, exist_ok=True)

    if source.suffix == ".i":
        return run([str(RCC), "-target=mini/none", *rcc_flags, str(source), str(output)])

    with tempfile.TemporaryDirectory(prefix="mini-lcc-") as tmp:
        preprocessed = Path(tmp) / f"{source.stem}.i"
        if WINDOWS:
            if not ensure_msvc_environment():
                print("error: no encuentro MSVC con el toolset de C++ para preprocesar", file=sys.stderr)
                return 2
            command = [
                "cl", "/nologo", "/EP", "/P", "/u", *[f"/D{d}" for d in (*PREDEFINED, *args.defines)],
                f"/I{INCLUDE}", *[f"/I{d.resolve()}" for d in args.includes],
                f"/Fi:{preprocessed}", str(source),
            ]
        else:
            command = [
                "cc", "-E", "-P", "-undef", *[f"-D{d}" for d in (*PREDEFINED, *args.defines)],
                "-I", str(INCLUDE), *[x for d in args.includes for x in ("-I", str(d.resolve()))], str(source),
                "-o", str(preprocessed),
            ]
        code = subprocess.call(command)
        if code != 0:
            return code
        if args.keep_i:
            keep_i = args.keep_i.resolve()
            keep_i.parent.mkdir(parents=True, exist_ok=True)
            keep_i.write_text(preprocessed.read_text(encoding="utf-8"), encoding="utf-8")
        return run([str(RCC), "-target=mini/none", *rcc_flags, str(preprocessed), str(output)])


if __name__ == "__main__":
    raise SystemExit(main())
