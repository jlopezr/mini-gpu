#!/usr/bin/env python3
"""Compila C a ensamblador MiniISA usando el submodulo y.lcc."""
from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MINI_LCC = ROOT / "y.lcc"
WINDOWS = sys.platform == "win32"
RCC = MINI_LCC / "build" / ("rcc.exe" if WINDOWS else "rcc")
INCLUDE = MINI_LCC / "include" / "mini" / "none"


def run(command: list[str], cwd: Path = MINI_LCC) -> int:
    return subprocess.call(command, cwd=str(cwd))


def ensure_rcc() -> int:
    if RCC.exists():
        return 0
    (MINI_LCC / "build").mkdir(exist_ok=True)
    if WINDOWS:
        return run([
            "powershell", "-NoProfile", "-ExecutionPolicy", "Bypass",
            "-File", str(MINI_LCC / "build-mini.ps1"),
        ])
    return run([
        "make",
        f"BUILDDIR={MINI_LCC / 'build'}",
        "HOSTFILE=etc/linux.c",
        "CFLAGS=-g -std=gnu89 -Wno-implicit-function-declaration",
        "rcc",
    ])


def ensure_msvc_environment() -> bool:
    """Carga el entorno x86 de MSVC cuando cl no esta ya en PATH."""
    if shutil.which("cl"):
        return True

    program_files_x86 = os.environ.get("ProgramFiles(x86)", "")
    program_files = os.environ.get("ProgramFiles", "")
    candidates: list[Path] = []
    vswhere = Path(program_files_x86) / "Microsoft Visual Studio" / "Installer" / "vswhere.exe"
    if vswhere.exists():
        result = subprocess.run(
            [str(vswhere), "-all", "-products", "*", "-property", "installationPath"],
            capture_output=True, text=True, check=False
        )
        candidates.extend(Path(line.strip()) for line in result.stdout.splitlines() if line.strip())
    candidates.extend([
        Path(program_files) / "Microsoft Visual Studio" / "2022" / "Community",
        Path(program_files) / "Microsoft Visual Studio" / "2022" / "BuildTools",
        Path(program_files_x86) / "Microsoft Visual Studio" / "2019" / "BuildTools",
    ])

    vcvars = next((root / "VC" / "Auxiliary" / "Build" / "vcvars32.bat"
                   for root in candidates
                   if (root / "VC" / "Auxiliary" / "Build" / "vcvars32.bat").exists()), None)
    if vcvars is None:
        return False
    result = subprocess.run(
        f'call "{vcvars}" >nul 2>&1 && set',
        shell=True, capture_output=True, text=True, check=False
    )
    if result.returncode != 0:
        return False
    for line in result.stdout.splitlines():
        name, separator, value = line.partition("=")
        if separator:
            os.environ[name] = value
    return shutil.which("cl") is not None


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path, help="fuente .c o .i")
    parser.add_argument("-o", "--output", type=Path, help="ensamblador de salida")
    parser.add_argument("--keep-i", type=Path, metavar="PATH",
                        help="guarda tambien el C preprocesado")
    parser.add_argument("--no-crt", action="store_true",
                        help="no emite `_start` ni `.comm __stack`: el arranque lo pone un crt0 "
                             "(1.isa/runtime/crt0.s) o, en una unidad sin `main`, nadie")
    args = parser.parse_args(argv)
    rcc_flags = ["-crt=none"] if args.no_crt else []

    script = MINI_LCC / "run-mini-tst.py"
    if not script.exists():
        print("error: falta el submodulo y.lcc", file=sys.stderr)
        print("Inicializalo con: git submodule update --init --recursive y.lcc", file=sys.stderr)
        return 2
    if not args.source.exists():
        print(f"error: no existe {args.source}", file=sys.stderr)
        return 2
    source = args.source.resolve()
    if ensure_rcc() != 0:
        return 1

    output = (args.output or args.source.with_suffix(".s")).resolve()
    output.parent.mkdir(parents=True, exist_ok=True)

    if source.suffix == ".i":
        return run([str(RCC), "-target=mini/none", *rcc_flags, str(source), str(output)])

    with tempfile.TemporaryDirectory(prefix="mini-lcc-") as tmp:
        preprocessed = Path(tmp) / f"{source.stem}.i"
        if WINDOWS:
            if not ensure_msvc_environment():
                print("error: no encuentro MSVC con el toolset de C++ para preprocesar", file=sys.stderr)
                return 2
            command = [
                "cl", "/nologo", "/EP", "/P", f"/I{INCLUDE}",
                f"/Fi:{preprocessed}", str(source),
            ]
        else:
            command = [
                "cc", "-E", "-P", "-I", str(INCLUDE), str(source),
                "-o", str(preprocessed),
            ]
        code = subprocess.call(command)
        if code != 0:
            return code
        if args.keep_i:
            keep_i = args.keep_i.resolve()
            keep_i.parent.mkdir(parents=True, exist_ok=True)
            keep_i.write_text(preprocessed.read_text(encoding="utf-8"), encoding="utf-8")
        return run([str(RCC), "-target=mini/none", *rcc_flags, str(preprocessed), str(output)])


if __name__ == "__main__":
    raise SystemExit(main())
