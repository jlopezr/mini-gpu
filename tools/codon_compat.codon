# Gemelo de `codon_compat.py` para Codon: mismos nombres, sin la biblioteca
# estándar que le falta. Cada función es el rodeo de una limitación de
# `tools/codon/LIMITACIONES.md`; cuando Codon la resuelva, se borra aquí y en
# `codon_compat.py`.


# l03: no hay módulo `dataclasses`. Las clases con campos declarados ya tienen
# `__init__` (con valores por defecto); no se usan `__eq__` ni `__repr__`.
def dataclass(cls):
    return cls


# l01: sin `struct`. Una sola lectura de 32 bits por el puntero, sin comprobar
# límites: quien llama ya ha comprobado que la palabra cae dentro de la RAM y
# está alineada (los núcleos lo hacen siempre antes, porque un acceso fuera es
# un fallo del programa simulado, no del simulador). Leer byte a byte, con
# cuatro comprobaciones, costaba un 10 % del bucle de la CPU. Asume un anfitrión
# little-endian, como MiniISA (ARM64 y x86-64 lo son).
def load_u32(memory: bytearray, address: int) -> int:
    return int(Ptr[u32](memory._ptr.as_byte() + address)[0])


def store_u32(memory: bytearray, address: int, value: int) -> None:
    Ptr[u32](memory._ptr.as_byte() + address)[0] = u32(value & 0xFFFFFFFF)


# l02: sin `int.from_bytes` ni `int.to_bytes`.
def load_le(memory: bytearray, address: int, size: int) -> int:
    value = 0
    for i in range(size):
        value |= memory[address + i] << (8 * i)
    return value


def store_le(memory: bytearray, address: int, size: int, value: int) -> None:
    for i in range(size):
        memory[address + i] = (value >> (8 * i)) & 0xFF
