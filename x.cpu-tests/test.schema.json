{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-gpu.local/cpu-test.schema.json",
  "title": "Caso de conformidad MiniCPU / MiniGPU",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "program",
    "expect",
    "architecture"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "program": {
      "type": "string",
      "pattern": "\\.(asm|bin|hex)$"
    },
    "max_instructions": {
      "type": "integer",
      "minimum": 1,
      "default": 1000000
    },
    "timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 5.0
    },
    "initial_memory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memoryFile"
      },
      "default": []
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "halted": {
          "type": "boolean",
          "default": true
        },
        "error": {
          "type": "boolean",
          "default": false
        },
        "error_code": {
          "$ref": "#/$defs/integer32"
        },
        "pc": {
          "$ref": "#/$defs/integer32"
        },
        "registers": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[Rr](?:[0-9]|[12][0-9]|3[01])$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/integer32"
          },
          "default": {}
        },
        "memory_dumps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/memoryFile"
          },
          "default": []
        },
        "instructions_executed": {
          "$ref": "#/$defs/integer32"
        },
        "warps": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-7]$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pc": {
                "$ref": "#/$defs/integer32"
              },
              "active_mask": {
                "$ref": "#/$defs/integer32"
              },
              "instructions_executed": {
                "$ref": "#/$defs/integer32"
              },
              "registers": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "pattern": "^[Rr](?:[0-9]|[12][0-9]|3[01])$"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/integer32"
                  },
                  "default": {}
                }
              }
            }
          }
        },
        "fault": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pc",
                "warp_id",
                "core_id",
                "address"
              ],
              "properties": {
                "pc": {
                  "$ref": "#/$defs/integer32"
                },
                "warp_id": {
                  "$ref": "#/$defs/integer32"
                },
                "core_id": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/integer32"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "address": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/integer32"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "warp_config": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "enum": [
        "cpu",
        "gpu"
      ]
    },
    "simulator_options": {
      "description": "Parámetros de construcción del simulador GPU. Requiere --backend gpu-simulator.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "simt_region_depth": {
          "type": "integer",
          "minimum": 1
        },
        "simt_path_depth": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$defs": {
    "integer32": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "string",
          "pattern": "^0[xX][0-9a-fA-F]{1,8}$"
        }
      ]
    },
    "memoryFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "file"
      ],
      "properties": {
        "address": {
          "$ref": "#/$defs/integer32"
        },
        "file": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "architecture": {
            "const": "gpu"
          }
        },
        "required": [
          "architecture"
        ]
      },
      "then": {
        "properties": {
          "expect": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "pc"
                  ]
                },
                {
                  "required": [
                    "registers"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "warp_config"
        ]
      },
      "else": {
        "properties": {
          "expect": {
            "required": [
              "pc"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "warps"
                  ]
                },
                {
                  "required": [
                    "instructions_executed"
                  ]
                },
                {
                  "required": [
                    "fault"
                  ]
                }
              ]
            }
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "warp_config"
              ]
            },
            {
              "required": [
                "simulator_options"
              ]
            }
          ]
        }
      }
    }
  ]
}
