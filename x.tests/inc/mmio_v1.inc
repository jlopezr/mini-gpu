; GENERADO por tools/generate-mmio desde 1.isa/mmio_map_v1.vh. No editar.
;
; La carpeta x.tests/inc ya va en el -I de run_tests.py y run_board.py,
; asi que basta con `.include` y el nombre.
.once

.equ MMIO_MEM_BASE, 0x00000000
.equ MMIO_MEM_SIZE_SDRAM, 0x02000000
.equ MMIO_MEM_SIZE_EBR, 0x00008000
.equ MMIO_VIDEO_BASE, 0x80000000
.equ MMIO_SERIAL_BASE, 0x80000200
.equ MMIO_CPU_PERF_BASE, 0x80000300
.equ MMIO_SYSTEM_BASE, 0x80000F00
.equ MMIO_VIDEO_FB_FRONT_OFF, 0x00000000
.equ MMIO_VIDEO_FB_BACK_OFF, 0x00000004
.equ MMIO_VIDEO_SWAP_OFF, 0x00000008
.equ MMIO_VIDEO_STATUS_OFF, 0x0000000C
.equ MMIO_VIDEO_SWAP_COUNT_OFF, 0x00000010
.equ MMIO_VIDEO_HALT_AT_OFF, 0x00000014
.equ MMIO_VIDEO_CTRL_OFF, 0x00000018
.equ MMIO_VIDEO_MODE_BLANK, 0x00000000
.equ MMIO_VIDEO_MODE_PATTERN, 0x00000001
.equ MMIO_VIDEO_MODE_SCANOUT, 0x00000002
.equ MMIO_VIDEO_FB_ALIGN, 0x00000004
.equ MMIO_SERIAL_DATA_OFF, 0x00000000
.equ MMIO_SERIAL_STATUS_OFF, 0x00000004
.equ MMIO_SERIAL_PEEK_OFF, 0x00000008
.equ MMIO_PERF_CYCLES_OFF, 0x00000000
.equ MMIO_PERF_RETIRED_OFF, 0x00000004

; Direcciones absolutas, por comodidad: base + offset.

.equ MMIO_VIDEO_FB_FRONT_ADDR, MMIO_VIDEO_BASE+0x00000000
.equ MMIO_VIDEO_FB_BACK_ADDR, MMIO_VIDEO_BASE+0x00000004
.equ MMIO_VIDEO_SWAP_ADDR, MMIO_VIDEO_BASE+0x00000008
.equ MMIO_VIDEO_STATUS_ADDR, MMIO_VIDEO_BASE+0x0000000C
.equ MMIO_VIDEO_SWAP_COUNT_ADDR, MMIO_VIDEO_BASE+0x00000010
.equ MMIO_VIDEO_HALT_AT_ADDR, MMIO_VIDEO_BASE+0x00000014
.equ MMIO_VIDEO_CTRL_ADDR, MMIO_VIDEO_BASE+0x00000018
.equ MMIO_SERIAL_DATA_ADDR, MMIO_SERIAL_BASE+0x00000000
.equ MMIO_SERIAL_STATUS_ADDR, MMIO_SERIAL_BASE+0x00000004
.equ MMIO_SERIAL_PEEK_ADDR, MMIO_SERIAL_BASE+0x00000008
