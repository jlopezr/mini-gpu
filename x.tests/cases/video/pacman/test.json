{
  "architecture": "cpu",
  "name": "pacman",
  "program": "pacman.asm",
  "requires": ["frame_capture", "subword_memory", "calls", "shift_immediate", "mul_div"],
  "run_until": {"swap": 10},
  "max_instructions": 1000000,
